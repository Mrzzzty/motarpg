/**
 * 第2层：路径生成器（文档二 第三节）
 * 决定：双主干路径结构（A/B路线）、侧室挂载、路径差异化与长度差约束。
 *
 * 路径A：更多精英房间（高风险高收益，P0-3 由 FloorGenerator 的路径归属提示驱动）；
 * 路径B：更多普通战斗（低风险中收益）。
 * 长度差 ≤ 2（FloorGenerator 主干轮转 + 插入休憩房容差保证）。
 * 商人/宝箱等侧室挂载到主干路径的中间节点上。
 * P0-4：路径内连续约束——禁止连续 2 个精英房 / 连续 3 个战斗房，违规者强制替换为宝箱房。
 */
import type { RoomType } from '../types';
import { rng } from '../utils/MathUtils';
import { dataManager } from '../core/DataManager';
import { Logger } from '../utils/Logger';
import type { FloorAllocation } from './FloorGenerator';

export type Rail = 'S' | 'A' | 'B' | 'E' | 'side';

export interface PlannedRoom {
  type: RoomType;
  /** S=起点 E=终点 A/B=主干成员 side=侧室 */
  rail: Rail;
  /** 主干上的序号（rail=A/B 时有效，0起始） */
  railIndex: number;
  /** 侧室挂载的目标（挂到链上哪个主干房间之后） */
  mountIndex: number;
  /** 是否在主干上（S/A/B/E 均视为主干节点） */
  isTrunk: boolean;
}

/**
 * 构建生成顺序链：S, a0, [sides(a0)], b0, [sides(b0)], a1, ... , E
 * 链上相邻房间即固定走廊的连接对象。
 */
export class PathGenerator {
  private static instance: PathGenerator;
  private constructor() {}
  static getInstance(): PathGenerator {
    if (!PathGenerator.instance) PathGenerator.instance = new PathGenerator();
    return PathGenerator.instance;
  }

  plan(alloc: FloorAllocation): PlannedRoom[] {
    const middle = alloc.roomTypes.slice(1, -1);

    if (alloc.kind !== 'normal' || middle.length < 2) {
      // 初始层 / Boss层 / 极小楼层：线性链，全部视为主干
      return alloc.roomTypes.map((type, i) => ({
        type,
        rail: (i === 0 ? 'S' : i === alloc.roomTypes.length - 1 ? 'E' : 'A') as Rail,
        railIndex: Math.max(0, i - 1),
        mountIndex: -1,
        isTrunk: true,
      }));
    }

    // 1. 分类：战斗/精英 → 主干（按 FloorGenerator 的路径归属提示，保留分配顺序）；
    //    宝箱（含 P0-4 强制替换后落在主干上的宝箱由本层内处理）→ 侧室；商人/女巫/铁匠 → 侧室
    const railA: RoomType[] = [];
    const railB: RoomType[] = [];
    const sideRooms: RoomType[] = [];
    const hints = alloc.railHints;
    if (hints) {
      middle.forEach((type, i) => {
        const h = hints[i + 1]; // 与 roomTypes 对齐（含首位的 start）
        if (h === 'A') railA.push(type);
        else if (h === 'B') railB.push(type);
        else sideRooms.push(type);
      });
    } else {
      // 旧版回退（无提示）：精英靠前分配给路径A，轮流分配
      const trunkCandidates = middle.filter(t => t === 'combat' || t === 'elite');
      sideRooms.push(...middle.filter(t => t === 'chest' || t === 'merchant' || t === 'witch' || t === 'blacksmith'));
      const sorted = [...trunkCandidates];
      sorted.sort((a, b) => (a === 'elite' ? 0 : 1) - (b === 'elite' ? 0 : 1));
      sorted.forEach((t, i) => {
        if (i % 2 === 0) railA.push(t); else railB.push(t);
      });
    }
    // 兜底：若某一侧为空则挪一个（k≥2 时不会发生）
    if (railB.length === 0 && railA.length >= 2) railB.push(railA.shift()!);
    if (railA.length === 0 && railB.length >= 2) railA.push(railB.shift()!);

    // 2. 精英房深度分布（P0-3）：精英避开各路径首位（贴近出生点），顺延到后续非精英房
    this.deferLeadingElites(railA);
    this.deferLeadingElites(railB);

    // 3. 路径内连续硬约束（P0-4）：连续精英/连续战斗的最后一个违规房替换为宝箱房
    this.enforceRailConstraints(railA);
    this.enforceRailConstraints(railB);
    // 约束替换可能让精英重新落在首位（如 [精英,精英]→[精英,宝箱]），再顺延一次
    this.deferLeadingElites(railA);
    this.deferLeadingElites(railB);

    // 4. 精英保底复核（P0-3×P0-4 协同）：约束替换后仍需满足 1~2 个精英房
    this.guaranteeEliteRooms(railA, railB, middle.length + 2);

    // 5. 保底休憩点（P1-3）：双路径各自累计战斗/精英房，每 4 个插入 1 个休憩房；
    //    不占基础房间名额，从额外房间配额（maxRooms - 当前总数）扣除
    this.insertRestRooms(railA, railB, middle.length + 2);

    // 6. 侧室挂载：挂在主干中间节点上（宝箱偏向主干尾部，商人偏向主干中部）
    const trunkLen = railA.length + railB.length;
    const mounts = sideRooms.map(type => {
      const midOffset = (type === 'merchant' || type === 'witch' || type === 'blacksmith')
        ? Math.floor(trunkLen / 2)            // 商人/女巫/铁匠挂主干正中
        : rng.randInt(Math.ceil(trunkLen / 2), trunkLen - 1); // 宝箱挂主干后半段
      return { type, mountIndex: Math.min(midOffset, trunkLen - 1) };
    });

    // 6. 组装链顺序：S, a0, sides(a0), b0, sides(b0), a1, ...
    const chain: PlannedRoom[] = [{
      type: alloc.roomTypes[0], rail: 'S', railIndex: 0, mountIndex: -1, isTrunk: true,
    }];

    const pushTrunk = (type: RoomType, rail: 'A' | 'B', railIndex: number) => {
      chain.push({ type, rail, railIndex, mountIndex: -1, isTrunk: true });
      // 该主干房间的序号（trunk 中的第几个）
      const trunkOrder = railIndex * 2 + (rail === 'A' ? 0 : 1);
      const sidesHere = mounts.map((m, mi) => ({ ...m, mi })).filter(m => m.mountIndex === trunkOrder);
      for (const s of sidesHere) {
        chain.push({ type: s.type, rail: 'side', railIndex: -1, mountIndex: trunkOrder, isTrunk: false });
      }
    };

    const n = Math.max(railA.length, railB.length);
    for (let i = 0; i < n; i++) {
      if (i < railA.length) pushTrunk(railA[i], 'A', i);
      if (i < railB.length) pushTrunk(railB[i], 'B', i);
    }
    // 未匹配挂载点（防御性）：直接挂链尾主干之后
    for (const s of mounts) {
      const trunkOrder = s.mountIndex;
      const already = chain.some(c => c.rail === 'side' && c.mountIndex === trunkOrder && c.type === s.type);
      if (!already && !chain.some(c => c.mountIndex === trunkOrder && c.rail === 'side')) {
        chain.splice(chain.length - 1, 0, { type: s.type, rail: 'side', railIndex: -1, mountIndex: trunkOrder, isTrunk: false });
      }
    }

    chain.push({ type: 'end', rail: 'E', railIndex: 0, mountIndex: -1, isTrunk: true });
    this.logRailTension(alloc.floorId, railA, railB);
    return chain;
  }

  /** 精英房避开路径首位：与后方最近的非精英房间互换（深度不足时顺延；无可换则保持） */
  private deferLeadingElites(rail: RoomType[]): void {
    if (rail.length < 2 || rail[0] !== 'elite') return;
    for (let j = 1; j < rail.length; j++) {
      if (rail[j] !== 'elite') {
        [rail[0], rail[j]] = [rail[j], rail[0]];
        return;
      }
    }
  }

  /**
   * 路径内连续硬约束（P0-4）：
   *   禁止连续 2 个精英房；禁止连续 3 个战斗房。
   * 触发违规时，将序列中最后一个违规房间强制替换为宝箱房（房间仍留在主干上）。
   */
  private enforceRailConstraints(rail: RoomType[]): void {
    for (let i = 1; i < rail.length; i++) {
      if (rail[i] === 'elite' && rail[i - 1] === 'elite') rail[i] = 'chest';
    }
    for (let i = 2; i < rail.length; i++) {
      if (rail[i] === 'combat' && rail[i - 1] === 'combat' && rail[i - 2] === 'combat') rail[i] = 'chest';
    }
  }

  /**
   * 精英保底复核（P0-3 步骤3与 P0-4 步骤7 协同）：
   * 普通楼层（房间总数≥6）在连续约束替换后仍保持 1~2 个精英房；
   * 优先在路径 A 的战斗房上补（避开精英邻居防连续违规），无战斗房时占用最深主干槽位。
   */
  private guaranteeEliteRooms(railA: RoomType[], railB: RoomType[], totalRooms: number): void {
    if (totalRooms < 6) return;
    const count = railA.filter(t => t === 'elite').length + railB.filter(t => t === 'elite').length;
    if (count >= 1) {
      if (count > 2) {
        // 超上限：每路径只保留最深的一个精英房（总数必 ≤2 且 ≥1），其余降为战斗房
        const downgrade = (rail: RoomType[]): void => {
          const lastIdx = rail.map((t, i) => ({ t, i })).filter(p => p.t === 'elite').pop()?.i ?? -1;
          for (let i = 0; i < rail.length; i++) {
            if (rail[i] === 'elite' && i !== lastIdx) rail[i] = 'combat';
          }
        };
        downgrade(railA);
        downgrade(railB);
      }
      return;
    }

    // 不足保底：优先 A 线非首位战斗房（替换后不与精英相邻），其次 B 线，最后占用最深槽位
    const spotOn = (rail: RoomType[], requireDeep: boolean): number => {
      const start = requireDeep ? 1 : 0;
      for (let i = rail.length - 1; i >= start; i--) {
        if (rail[i] !== 'combat') continue;
        const prevElite = i > 0 && rail[i - 1] === 'elite';
        const nextElite = i + 1 < rail.length && rail[i + 1] === 'elite';
        if (!prevElite && !nextElite) return i;
      }
      return -1;
    };
    let rail = railA;
    let idx = spotOn(railA, true);
    if (idx < 0) { rail = railB; idx = spotOn(railB, true); }
    if (idx < 0) { rail = railA; idx = spotOn(railA, false); }
    if (idx >= 0) {
      rail[idx] = 'elite';
      // 补位后重跑连续约束（精英补位不可能造成连续精英，战斗减员不可能造成连续战斗，防御性调用）
      this.enforceRailConstraints(rail);
      return;
    }
    // 无战斗房：占用路径 A 最深槽位
    const target = railA.length > 0 ? railA : railB;
    if (target.length > 0) target[target.length - 1] = 'elite';
    else railA.push('elite'); // 防御：双路径皆空（全部正面房间）时补一个主干战斗房
  }

  /**
   * 保底休憩点（P1-3）：单条路径内每累计 4 个战斗/精英房，在其后插入 1 个休憩房（5×5）。
   * 双路径独立累计、互不影响；休憩房不占基础房间名额，从额外房间配额
   * （maxRooms − 楼层基础房间总数）中扣除，配额不足时停止插入。
   */
  private insertRestRooms(railA: RoomType[], railB: RoomType[], baseTotal: number): void {
    const quota = { left: Math.max(0, dataManager.mapGen.maxRooms - baseTotal) };
    const insertInto = (rail: RoomType[]): void => {
      let battles = 0;
      for (let i = 0; i < rail.length; i++) {
        if (rail[i] !== 'combat' && rail[i] !== 'elite') continue;
        battles++;
        if (battles % 4 === 0 && quota.left > 0) {
          rail.splice(i + 1, 0, 'rest');
          quota.left--;
          i++; // 跳过刚插入的休憩房
        }
      }
    };
    insertInto(railA);
    insertInto(railB);
  }

  /** 替换后回退重算各路径 Tension（P0-3 新权重与路径系数；仅用于日志/验证） */
  private logRailTension(floorId: number, railA: RoomType[], railB: RoomType[]): void {
    const weights = dataManager.mapGen.tension.weights;
    const factors: Record<'A' | 'B', { combat: number; elite: number }> = {
      A: { combat: 0.8, elite: 0.7 },
      B: { combat: 1.0, elite: 1.2 },
    };
    const calc = (rail: RoomType[], f: { combat: number; elite: number }): number =>
      rail.reduce((t, type) => {
        const w = weights[type] ?? 0;
        const factor = type === 'combat' ? f.combat : type === 'elite' ? f.elite : 1;
        return t + w * factor;
      }, 0);
    Logger.debug(`[PathGen] 楼层${floorId} A=[${railA.join(',')}] T=${calc(railA, factors.A).toFixed(1)} | ` +
      `B=[${railB.join(',')}] T=${calc(railB, factors.B).toFixed(1)}`);
  }

  /** 长度差校验值：路径A与路径B的房间数差（文档要求 ≤2） */
  pathLengthDiff(plan: PlannedRoom[]): number {
    const a = plan.filter(p => p.rail === 'A').length;
    const b = plan.filter(p => p.rail === 'B').length;
    return Math.abs(a - b);
  }

  /** 校验配置约束（冗余保险，ceil/floor 分配已保证） */
  validateDiff(plan: PlannedRoom[]): boolean {
    return this.pathLengthDiff(plan) <= dataManager.mapGen.path.maxLengthDiff;
  }
}
