/**
 * 俯视+高度渲染器（视角调整文档）：
 * 正方形网格；screenY 从小到大排序绘制（遮挡关系）；
 * 虚空格(-1)不绘制，显示背景色；
 * 墙壁/实体绘制为"从地面立起"的盒子（z 高度）。
 * 性能：视口外的格子/物体不绘制；DPR 适配。
 */
import type { MapEntity, RoomData } from '../types';
import { dataManager } from '../core/DataManager';
import { WorldManager } from '../core/WorldManager';
import { Player } from '../entities/Player';
import { CameraController } from '../core/CameraController';
import { projection } from './Projection';
import { LightSystem } from './LightSystem';
import { ShadowSystem, type DynamicShadowItem } from './ShadowSystem';
import { ParticleSystem } from '../effects/ParticleSystem';
import { placeholderArt } from './PlaceholderArt';

/** 房间类型地面色（保持明亮，可读性优先） */
const FLOOR_COLORS: Record<string, { base: string; alt: string; line: string }> = {
  start:   { base: '#8a97a8', alt: '#8290a2', line: 'rgba(255,255,255,0.10)' },
  end:     { base: '#8fa3b8', alt: '#869bb0', line: 'rgba(255,255,255,0.10)' },
  combat:  { base: '#7f8a99', alt: '#788493', line: 'rgba(255,255,255,0.08)' },
  elite:   { base: '#8d8494', alt: '#857d8c', line: 'rgba(255,255,255,0.08)' },
  chest:   { base: '#9a9184', alt: '#928a7d', line: 'rgba(255,255,255,0.10)' },
  merchant:{ base: '#87987f', alt: '#809178', line: 'rgba(255,255,255,0.10)' },
  boss:    { base: '#8c7a80', alt: '#847378', line: 'rgba(255,255,255,0.08)' },
  rest:    { base: '#87987f', alt: '#809178', line: 'rgba(255,255,255,0.10)' },
  corridor:{ base: '#75808f', alt: '#6f7a89', line: 'rgba(255,255,255,0.07)' },
};

interface RenderItem {
  screenY: number;
  draw: (ctx: CanvasRenderingContext2D) => void;
}

export class IsometricRenderer {
  private static instance: IsometricRenderer;
  private canvas: HTMLCanvasElement | null = null;
  private ctx: CanvasRenderingContext2D | null = null;
  /** 鼠标悬浮格高亮（-1无） */
  public hoverTile: { x: number; y: number } | null = null;

  private constructor() {}
  static getInstance(): IsometricRenderer {
    if (!IsometricRenderer.instance) IsometricRenderer.instance = new IsometricRenderer();
    return IsometricRenderer.instance;
  }

  attach(canvas: HTMLCanvasElement): void {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
  }

  render(timeMs: number): void {
    const ctx = this.ctx;
    const canvas = this.canvas;
    if (!ctx || !canvas) return;
    const world = WorldManager.getInstance();
    const floor = world.currentFloor;
    if (!floor) return;

    this.resize(canvas);

    const dpr = window.devicePixelRatio || 1;
    const cssW = canvas.clientWidth;
    const cssH = canvas.clientHeight;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, cssW, cssH);

    const cam = CameraController.getInstance();
    const originX = cssW / 2 - cam.x;
    const originY = cssH / 2 - cam.y;
    ctx.translate(originX, originY);

    // 视口范围（相机空间）
    const viewLeft = cam.x - cssW / 2 - 80;
    const viewRight = cam.x + cssW / 2 + 80;
    const viewTop = cam.y - cssH / 2 - 140;
    const viewBottom = cam.y + cssH / 2 + 60;

    // ===== 1. 背景色（虚空） =====
    // （环境光暗角见管线末尾的屏幕空间覆盖层）

    // ===== 2. 静态影子（墙壁/柱子，预计算缓存） =====
    const shadows = ShadowSystem.getInstance();
    shadows.drawStatic(ctx, floor, { left: viewLeft, right: viewRight, top: viewTop, bottom: viewBottom },
      cam, cssW, cssH);

    // ===== 3. 地面图层（正方形砖 + 网格线 + 地毯）；虚空格不绘制 =====
    const roomGrid = this.buildRoomLookup(floor.rooms);
    const carpets = this.buildCarpetLookup(world);
    for (let row = 0; row < floor.height; row++) {
      for (let col = 0; col < floor.width; col++) {
        const tile = floor.grid[row][col];
        if (tile !== 0) continue; // -1虚空不绘制；1墙2装饰在立体层绘制
        const center = projection.tileCenter(row, col);
        if (center.x < viewLeft || center.x > viewRight || center.y < viewTop || center.y > viewBottom) continue;
        const roomKey = roomGrid[`${col},${row}`];
        const palette = FLOOR_COLORS[roomKey ?? 'corridor'];
        const checker = (row + col) % 2 === 0 ? palette.base : palette.alt;
        this.drawFloorTile(ctx, center.x, center.y, checker, palette.line);
        if (carpets.has(`${col},${row}`)) this.drawCarpet(ctx, center.x, center.y);
      }
    }

    // ===== 4. 光源收集 + 光线投射阴影纹理（multiply，硬阴影边界） =====
    const lightSystem = LightSystem.getInstance();
    lightSystem.update(timeMs);
    const lights = lightSystem.collect();
    const viewRect = { left: viewLeft, right: viewRight, top: viewTop, bottom: viewBottom };
    lightSystem.drawLightTextures(ctx, timeMs, viewRect);

    // ===== 5. 地面光晕（lighter，混合衰减提亮） =====
    lightSystem.drawGroundLights(ctx, timeMs, viewRect);

    // ===== 6. 动态物体阴影（角色/怪物/宝箱脚下椭圆） =====
    shadows.drawDynamic(ctx, this.collectShadowItems(world, viewRect), lights);

    // ===== 4/5. 墙壁图层 + 动态物体渲染（按 screenY 排序；虚空格无墙） =====
    const items: RenderItem[] = [];
    const heights = dataManager.config.heights;

    for (let row = 0; row < floor.height; row++) {
      for (let col = 0; col < floor.width; col++) {
        const tile = floor.grid[row][col];
        if (tile !== 1 && tile !== 2) continue; // 虚空(-1)与地板(0)不在立体层
        const center = projection.tileCenter(row, col);
        if (center.x < viewLeft || center.x > viewRight || center.y < viewTop - 120 || center.y > viewBottom) continue;
        const isPillar = tile === 2;
        const roomKey = roomGrid[`${col},${row}`];
        const wallH = isPillar
          ? heights.pillar
          : roomKey && heights.wallByRoom[roomKey] ? heights.wallByRoom[roomKey] : heights.corridorWall;
        items.push({
          screenY: center.y,
          draw: c => this.drawWall(c, center.x, center.y, wallH, !!roomKey, isPillar),
        });
      }
    }

    // 实体
    for (const { entity, room } of world.allEntities()) {
      const center = projection.tileCenter(entity.y, entity.x);
      if (center.x < viewLeft || center.x > viewRight || center.y < viewTop - 120 || center.y > viewBottom) continue;
      if (entity.kind === 'carpet') continue; // 地面层已绘制
      items.push({ screenY: center.y, draw: c => this.drawEntity(c, entity, room, center.x, center.y) });
    }

    // 玩家
    const player = Player.getInstance();
    const pc = projection.tileCenter(player.state.y, player.state.x);
    if (pc.x >= viewLeft && pc.x <= viewRight && pc.y >= viewTop && pc.y <= viewBottom) {
      items.push({ screenY: pc.y, draw: c => placeholderArt.drawPlayer(c, pc.x, pc.y) });
    }

    items.sort((a, b) => a.screenY - b.screenY);
    for (const item of items) item.draw(ctx);

    // ===== 6/7. 墙壁光晕 + 自发光光晕（物体之上，氛围） =====
    LightSystem.getInstance().drawWallLights(ctx, timeMs);
    shadows.drawSelfGlow(ctx,
      world.allEntities().map(({ entity }) => ({
        entity,
        alive: world.isEntityAlive(entity),
        opened: entity.kind === 'chest' ? world.isChestOpened(entity) : false,
      })),
      timeMs, { left: viewLeft, right: viewRight, top: viewTop, bottom: viewBottom });

    // ===== 8. 丁达尔效应（火把光锥 + 飘尘粒子） =====
    shadows.drawTyndall(ctx, lights, timeMs);

    // ===== 9. 悬浮格高亮（正方形） =====
    if (this.hoverTile) {
      const hc = projection.tileCenter(this.hoverTile.y, this.hoverTile.x);
      const half = projection.tileSize / 2;
      ctx.save();
      ctx.strokeStyle = 'rgba(255,255,255,0.6)';
      ctx.lineWidth = 2;
      ctx.strokeRect(hc.x - half, hc.y - half, half * 2, half * 2);
      ctx.restore();
    }

    // ===== 6. 粒子（相机空间） =====
    ParticleSystem.getInstance().draw(ctx);

    // ===== 7. 环境光暗角（≤30%，中心跟随玩家，屏幕空间） =====
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    this.drawVignette(ctx, cssW, cssH, pc.x + originX, pc.y + originY);
  }

  /** 收集动态影子条目（视野内，玩家优先，≤20 个由 ShadowSystem 截断） */
  private collectShadowItems(
    world: WorldManager,
    view: { left: number; right: number; top: number; bottom: number },
  ): DynamicShadowItem[] {
    const items: DynamicShadowItem[] = [];
    const inView = (x: number, y: number): boolean => {
      const c = projection.tileCenter(y, x);
      return c.x >= view.left && c.x <= view.right && c.y >= view.top - 60 && c.y <= view.bottom;
    };
    const tileSize = projection.tileSize;
    const push = (item: DynamicShadowItem) => { if (inView(item.x, item.y)) items.push(item); };

    // 玩家（优先保留）
    const player = Player.getInstance();
    push({ x: player.state.x, y: player.state.y, height: dataManager.config.heights.player, radius: tileSize * 0.3, alpha: 0.3 });

    for (const { entity } of world.allEntities()) {
      const heights = dataManager.config.heights;
      switch (entity.kind) {
        case 'monster':
          push({
            x: entity.x, y: entity.y,
            height: entity.isElite ? heights.monsterElite : dataManager.getMonster(entity.monsterId ?? '')?.height ?? heights.monsterNormal,
            radius: tileSize * (entity.isElite ? 0.32 : 0.26),
            alpha: 0.25,
          });
          break;
        case 'boss':
          push({ x: entity.x, y: entity.y, height: heights.boss, radius: tileSize * 0.42, alpha: 0.2 });
          break;
        case 'chest':
          push({ x: entity.x, y: entity.y, height: heights.chest, radius: tileSize * 0.24, alpha: 0.25 });
          break;
        case 'npc':
          push({ x: entity.x, y: entity.y, height: heights.npc, radius: tileSize * 0.28, alpha: 0.25 });
          break;
        case 'torch':
          push({ x: entity.x, y: entity.y, height: heights.torch, radius: 6, alpha: 0.2 });
          break;
        default:
          break;
      }
    }
    return items;
  }

  // ============ 绘制原语（俯视+高度） ============

  /** 正方形地砖 + 网格线 */
  private drawFloorTile(ctx: CanvasRenderingContext2D, cx: number, cy: number, color: string, line: string): void {
    const half = projection.tileSize / 2;
    ctx.fillStyle = color;
    ctx.fillRect(cx - half, cy - half, half * 2, half * 2);
    // 网格线（细线，增强空间感）
    ctx.strokeStyle = line;
    ctx.lineWidth = dataManager.config.render.gridLineWidth;
    ctx.strokeRect(cx - half, cy - half, half * 2, half * 2);
  }

  private drawCarpet(ctx: CanvasRenderingContext2D, cx: number, cy: number): void {
    const half = projection.tileSize / 2 * 0.92;
    ctx.save();
    ctx.fillStyle = 'rgba(160,60,60,0.55)';
    ctx.fillRect(cx - half, cy - half, half * 2, half * 2);
    ctx.strokeStyle = 'rgba(220,150,80,0.5)';
    ctx.lineWidth = 2;
    ctx.strokeRect(cx - half, cy - half, half * 2, half * 2);
    ctx.restore();
  }

  /** 墙壁：从地面立起的盒子（正面可见，砖缝纹理），底部在地面，顶部在 地面-height */
  private drawWall(ctx: CanvasRenderingContext2D, cx: number, cy: number, height: number, inRoom: boolean, isPillar: boolean): void {
    const half = projection.tileSize / 2;
    const left = isPillar ? '#6d6d75' : inRoom ? '#565d6b' : '#4b515e';
    const top = isPillar ? '#9d9da6' : inRoom ? '#7d8697' : '#6f7889';

    // 立身（从地面到 地面-height）
    ctx.fillStyle = left;
    ctx.fillRect(cx - half, cy - half - height, half * 2, height);
    // 底座脚印
    ctx.fillStyle = isPillar ? '#7d7d86' : inRoom ? '#646c7b' : '#565d6b';
    ctx.fillRect(cx - half, cy - half, half * 2, half * 2);
    // 顶面（略亮）
    ctx.fillStyle = top;
    ctx.fillRect(cx - half, cy - half - height, half * 2, half * 2);

    // 边框
    ctx.strokeStyle = 'rgba(20,24,32,0.55)';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(cx - half, cy - half - height, half * 2, height + half * 2);

    // 砖缝纹理（横线2道）
    ctx.strokeStyle = 'rgba(15,18,26,0.35)';
    ctx.lineWidth = 1;
    for (const frac of [0.35, 0.7]) {
      const y = cy - half - height * frac;
      ctx.beginPath();
      ctx.moveTo(cx - half, y);
      ctx.lineTo(cx + half, y);
      ctx.stroke();
    }
  }

  /** 实体分发绘制 */
  private drawEntity(ctx: CanvasRenderingContext2D, e: MapEntity, room: RoomData, cx: number, cy: number): void {
    const world = WorldManager.getInstance();
    const heights = dataManager.config.heights;
    switch (e.kind) {
      case 'monster': {
        const def = dataManager.getMonster(e.monsterId ?? '');
        if (!def) return;
        placeholderArt.drawMonster(ctx, cx, cy, def.name, def.color, !!e.isElite, false,
          e.isElite ? heights.monsterElite : def.height);
        break;
      }
      case 'boss': {
        const def = dataManager.getMonster(e.monsterId ?? '');
        if (!def) return;
        placeholderArt.drawMonster(ctx, cx, cy, def.name, def.color, false, true, heights.boss);
        break;
      }
      case 'chest':
        placeholderArt.drawChest(ctx, cx, cy, world.isChestOpened(e), e.chestTier === 'grand');
        break;
      case 'npc': {
        const def = dataManager.getNpc(e.npcId ?? '');
        placeholderArt.drawNpc(ctx, cx, cy, def?.name ?? 'NPC', def?.color ?? '#44dd66');
        break;
      }
      case 'stair':
        placeholderArt.drawStair(ctx, cx, cy, e.targetFloor ?? room.floorId + 1);
        break;
      case 'torch': {
        // 壁挂火把：贴在墙上（有墙高度感）
        const wallH = heights.wallByRoom[room.type] ?? heights.corridorWall;
        placeholderArt.drawTorch(ctx, cx, cy, wallH);
        break;
      }
      case 'pillar':
        placeholderArt.drawPillar(ctx, cx, cy);
        break;
      default:
        break;
    }
  }

  /** 环境光暗角：径向渐变，中心透明，边缘 ≤30% 黑 */
  private drawVignette(ctx: CanvasRenderingContext2D, w: number, h: number, playerX: number, playerY: number): void {
    const maxAlpha = dataManager.config.render.vignetteMax;
    const cx = Math.max(w * 0.25, Math.min(w * 0.75, playerX));
    const cy = Math.max(h * 0.25, Math.min(h * 0.75, playerY));
    const radius = Math.max(w, h) * 0.75;
    const gradient = ctx.createRadialGradient(cx, cy, radius * 0.35, cx, cy, radius);
    gradient.addColorStop(0, 'rgba(0,0,0,0)');
    gradient.addColorStop(1, `rgba(0,0,0,${maxAlpha})`);
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, w, h);
  }

  private diamondPath(ctx: CanvasRenderingContext2D, cx: number, cy: number, scale: number): void {
    // 俯视图：正方形路径（保留旧API名，调用方已改用fillRect/strokeRect）
    const half = (projection.tileSize / 2) * scale;
    ctx.beginPath();
    ctx.rect(cx - half, cy - half, half * 2, half * 2);
    ctx.closePath();
  }

  /** "col,row" → 房间类型 查找表 */
  private buildRoomLookup(rooms: RoomData[]): Record<string, string> {
    const map: Record<string, string> = {};
    for (const room of rooms) {
      for (let y = room.y; y < room.y + room.height; y++) {
        for (let x = room.x; x < room.x + room.width; x++) {
          map[`${x},${y}`] = room.type;
        }
      }
    }
    return map;
  }

  private buildCarpetLookup(world: WorldManager): Set<string> {
    const set = new Set<string>();
    for (const { entity } of world.allEntities()) {
      if (entity.kind === 'carpet') set.add(`${entity.x},${entity.y}`);
    }
    return set;
  }

  private resize(canvas: HTMLCanvasElement): void {
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
    }
  }
}
