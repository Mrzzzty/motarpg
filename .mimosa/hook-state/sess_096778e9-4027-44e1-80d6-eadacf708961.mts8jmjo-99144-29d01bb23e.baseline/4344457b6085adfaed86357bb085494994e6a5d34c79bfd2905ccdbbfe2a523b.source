/**
 * 光线追踪光照系统（光线追踪系统设计文档）：
 * 2D 光线投射（Ray Casting）——从光源向圆周发射采样射线，步进 AABB 碰撞检测（墙壁格），
 * 依碰撞结果构建阴影楔形，生成带硬阴影边界的动态光照纹理。
 *
 * 管线（文档 八）：
 *   光照纹理（离屏Canvas，resolutionScale 缩放）= 径向光晕（混合衰减）
 *     + 阴影楔形（阴影色 = 光源补色压暗，随距离渐变，multiply 叠加）
 *   合成：纹理 multiply 到主画布（光照/阴影），地面光晕 lighter 叠加（提亮）。
 *
 * 缓存（文档 五）：静态光源（火把/楼梯/宝箱/传送门/窗口）光照贴图按 id 缓存，
 * 换层或分辨率变化时失效；动态光源（玩家）位移 >5px 或超过 updateInterval 帧才重算。
 * 自适应分辨率（文档 4.4）：fps<55 降 5%，fps≥60 升 5%，调整间隔 ≥10 帧。
 */
import { dataManager } from '../core/DataManager';
import { WorldManager } from '../core/WorldManager';
import { Player } from '../entities/Player';
import { projection } from './Projection';

// ============ 数据结构（文档 七） ============

export type RayLightType =
  | 'player' | 'torch' | 'window_cold' | 'window_warm'
  | 'boss' | 'chest' | 'portal' | 'stair';

interface RGB { r: number; g: number; b: number }

export interface RayLight {
  id: string;
  type: RayLightType;
  /** 世界格坐标 */
  x: number;
  y: number;
  intensity: number;
  color: RGB;
  shadowColor: RGB;
  /** 光照半径（px） */
  radius: number;
  /** 衰减系数 */
  attenuation: number;
  resolutionMultiplier: number;
  /** 墙壁光竖向范围（px），0 = 无 */
  wallGlow: number;
  flicker: { enabled: boolean; speed: number; amplitude: number };
  /** 静态光源：位置固定，纹理可缓存（文档 五.3） */
  isStatic: boolean;
  /** 更新计数器（帧间隔控制） */
  updateCounter: number;
  /** 更新优先级 P0-P4（文档 六.1） */
  priority: number;
}

export interface PerformanceConfig {
  rayCount: number;
  stepSize: number;
  maxDistance: number;
  resolutionScale: number;
  shadowSoftness: number;
  updateInterval: number;
  maxActiveLights: number;
}

/** 预置性能等级（文档 4.2 附录） */
export const PERF_LEVELS: PerformanceConfig[] = [
  { rayCount: 24, stepSize: 8, maxDistance: 200, resolutionScale: 0.25, shadowSoftness: 0.6, updateInterval: 5, maxActiveLights: 2 },
  { rayCount: 48, stepSize: 6, maxDistance: 250, resolutionScale: 0.33, shadowSoftness: 0.5, updateInterval: 3, maxActiveLights: 4 },
  { rayCount: 72, stepSize: 4, maxDistance: 300, resolutionScale: 0.5, shadowSoftness: 0.4, updateInterval: 2, maxActiveLights: 6 },
  { rayCount: 96, stepSize: 3, maxDistance: 350, resolutionScale: 0.75, shadowSoftness: 0.3, updateInterval: 1, maxActiveLights: 8 },
  { rayCount: 120, stepSize: 2, maxDistance: 400, resolutionScale: 1.0, shadowSoftness: 0.25, updateInterval: 1, maxActiveLights: 10 },
];

interface LightConfig {
  color: RGB;
  shadowColor: RGB;
  intensity: number;
  radius: number;
  attenuation: number;
  resolutionMultiplier: number;
  wallGlow: number;
  flicker: { enabled: boolean; speed: number; amplitude: number };
}

/** 光源配置表（文档 3.1 颜色体系 + 3.3 阴影色 + 4.3 分辨率倍率 + 7.4） */
export const LIGHT_CONFIGS: Record<RayLightType, LightConfig> = {
  player: {
    color: { r: 255, g: 200, b: 100 }, shadowColor: { r: 20, g: 25, b: 35 },
    intensity: 0.8, radius: 200, attenuation: 0.004, resolutionMultiplier: 1.0, wallGlow: 0,
    flicker: { enabled: true, speed: 2.0, amplitude: 0.08 },
  },
  torch: {
    color: { r: 255, g: 180, b: 80 }, shadowColor: { r: 25, g: 30, b: 40 },
    intensity: 0.7, radius: 240, attenuation: 0.004, resolutionMultiplier: 0.5, wallGlow: 70,
    flicker: { enabled: true, speed: 3.0, amplitude: 0.12 },
  },
  window_cold: {
    color: { r: 180, g: 220, b: 255 }, shadowColor: { r: 30, g: 35, b: 45 },
    intensity: 0.9, radius: 350, attenuation: 0.0015, resolutionMultiplier: 0.7, wallGlow: 0,
    flicker: { enabled: false, speed: 0, amplitude: 0 },
  },
  window_warm: {
    color: { r: 255, g: 220, b: 180 }, shadowColor: { r: 20, g: 25, b: 35 },
    intensity: 0.85, radius: 300, attenuation: 0.002, resolutionMultiplier: 0.7, wallGlow: 0,
    flicker: { enabled: false, speed: 0, amplitude: 0 },
  },
  boss: {
    color: { r: 220, g: 40, b: 60 }, shadowColor: { r: 40, g: 20, b: 22 },
    intensity: 0.6, radius: 250, attenuation: 0.003, resolutionMultiplier: 0.8, wallGlow: 90,
    flicker: { enabled: true, speed: 0.5, amplitude: 0.15 },
  },
  chest: {
    color: { r: 255, g: 200, b: 50 }, shadowColor: { r: 20, g: 30, b: 35 },
    intensity: 0.3, radius: 80, attenuation: 0.008, resolutionMultiplier: 0.3, wallGlow: 0,
    flicker: { enabled: true, speed: 3.0, amplitude: 0.2 },
  },
  portal: {
    color: { r: 120, g: 80, b: 255 }, shadowColor: { r: 25, g: 20, b: 35 },
    intensity: 0.7, radius: 280, attenuation: 0.0025, resolutionMultiplier: 0.6, wallGlow: 60,
    flicker: { enabled: true, speed: 1.5, amplitude: 0.1 },
  },
  stair: {
    color: { r: 80, g: 200, b: 255 }, shadowColor: { r: 30, g: 30, b: 25 },
    intensity: 0.7, radius: 260, attenuation: 0.002, resolutionMultiplier: 0.6, wallGlow: 0,
    flicker: { enabled: true, speed: 0.8, amplitude: 0.05 },
  },
};

/** 光线衰减（文档 2.3 混合衰减）：t=归一化距离 → 强度 */
export function attenuationAt(distance: number, maxDistance: number): number {
  const t = distance / maxDistance;
  return Math.max(0, 1 / (1 + t * t * 8));
}

/** 阴影颜色（文档 3.2）：光源补色 × 阴影深度 × 0.5 + 底亮 */
export function calculateShadowColor(lightColor: RGB, distance: number, maxDistance: number): RGB {
  const t = distance / maxDistance;
  const intensity = 1 / (1 + t * t * 8);
  const shadowFactor = 1 - intensity;
  return {
    r: (255 - lightColor.r) * shadowFactor * 0.5,
    g: (255 - lightColor.g) * shadowFactor * 0.5,
    b: (255 - lightColor.b) * shadowFactor * 0.5 + 10,
  };
}

interface LightTexture {
  canvas: HTMLCanvasElement;
  /** 纹理覆盖的世界尺寸（px，= radius×2），绘制时按 canvas 实际尺寸缩放 */
  worldSize: number;
  lastUpdate: number;
}

export class LightSystem {
  private static instance: LightSystem;
  private constructor() {
    this.setLevel(dataManager.config.raycast?.level ?? 2);
  }
  static getInstance(): LightSystem {
    if (!LightSystem.instance) LightSystem.instance = new LightSystem();
    return LightSystem.instance;
  }

  private perf: PerformanceConfig = PERF_LEVELS[2];
  /** 自适应分辨率（文档 4.4）：在 [0.25,1.0] 内调整 */
  private resolutionScale = 1;
  private frame = 0;
  private lastTimeMs = 0;
  private fpsEma = 60;
  /** 当前生效的实际 scale（= perf.resolutionScale × 自适应系数） */
  private effScale = 0.5;

  private lights: RayLight[] = [];
  private textures = new Map<string, LightTexture>();
  private textureFloorId = -1;
  private textureScale = -1;

  private wallSet = new Set<string>();
  private wallFloorId = -1;

  // ============ 光源收集 ============

  /** 每帧收集活跃光源（优先级排序，截断到 maxActiveLights） */
  collect(): RayLight[] {
    const world = WorldManager.getInstance();
    const player = Player.getInstance();
    const found: RayLight[] = [];
    const mk = (type: RayLightType, id: string, x: number, y: number, isStatic: boolean, priority: number): RayLight => {
      const cfg = LIGHT_CONFIGS[type];
      return {
        id, type, x, y, isStatic, priority,
        intensity: cfg.intensity, radius: cfg.radius, attenuation: cfg.attenuation,
        color: cfg.color, shadowColor: cfg.shadowColor,
        resolutionMultiplier: cfg.resolutionMultiplier, wallGlow: cfg.wallGlow,
        flicker: cfg.flicker, updateCounter: 0,
      };
    };

    found.push(mk('player', 'light_player', player.state.x, player.state.y, false, 0));

    if (world.currentFloor) {
      for (const { entity } of world.allEntities()) {
        if (entity.kind === 'torch') found.push(mk('torch', `light_${entity.id}`, entity.x, entity.y, true, 2));
        else if (entity.kind === 'boss' && world.isEntityAlive(entity)) found.push(mk('boss', `light_${entity.id}`, entity.x, entity.y, true, 1));
        else if (entity.kind === 'chest' && !world.isChestOpened(entity)) found.push(mk('chest', `light_${entity.id}`, entity.x, entity.y, true, 4));
        else if (entity.kind === 'stair') found.push(mk('stair', `light_${entity.id}`, entity.x, entity.y, true, 4));
      }
    }

    found.sort((a, b) => a.priority - b.priority);
    this.lights = found.slice(0, this.perf.maxActiveLights);
    return this.lights;
  }

  // ============ 性能等级与自适应 ============

  setLevel(level: number): void {
    this.perf = PERF_LEVELS[Math.max(0, Math.min(PERF_LEVELS.length - 1, Math.floor(level)))];
    this.resolutionScale = this.perf.resolutionScale;
    this.effScale = this.resolutionScale;
    this.invalidateTextures();
  }

  /** 每帧调用：帧率统计 + 自适应分辨率（调整间隔 ≥10 帧，±5%，边界 [0.25,1.0]） */
  update(timeMs: number): void {
    if (this.lastTimeMs > 0) {
      const dt = timeMs - this.lastTimeMs;
      if (dt > 0 && dt < 500) {
        this.fpsEma = this.fpsEma * 0.9 + (1000 / dt) * 0.1;
      }
    }
    this.lastTimeMs = timeMs;
    this.frame++;
    if (this.frame % 10 !== 0) return;
    let changed = false;
    if (this.fpsEma < 55) {
      this.resolutionScale = Math.max(0.25, this.resolutionScale * 0.95);
      changed = true;
    } else if (this.fpsEma >= 60 && this.resolutionScale < 1.0) {
      this.resolutionScale = Math.min(1.0, this.resolutionScale * 1.05);
      changed = true;
    }
    if (changed) {
      this.effScale = this.resolutionScale;
      if (Math.abs(this.effScale - this.textureScale) > 0.01) this.invalidateTextures();
    }
  }

  // ============ 障碍物（AABB 网格索引） ============

  private ensureWalls(floor: { floorId: number; grid: number[][]; width: number; height: number }): void {
    if (this.wallFloorId === floor.floorId) return;
    this.wallSet.clear();
    for (let row = 0; row < floor.height; row++) {
      for (let col = 0; col < floor.width; col++) {
        if (floor.grid[row][col] === 1) this.wallSet.add(`${col},${row}`); // 装饰(2)不参与碰撞（10.2.4）
      }
    }
    this.wallFloorId = floor.floorId;
  }

  /** AABB 点测试：墙壁格即轴对齐包围盒；越界视为阻断 */
  private isBlocked(px: number, py: number): boolean {
    const ts = projection.tileSize;
    const col = Math.floor(px / ts);
    const row = Math.floor(py / ts);
    if (col < 0 || row < 0) return true;
    return this.wallSet.has(`${col},${row}`);
  }

  // ============ 光线投射（文档 2.1） ============

  /** 对单光源执行光线投射，返回 [ {角度, 碰撞距离} ] */
  private rayCast(ox: number, oy: number, light: RayLight): { angle: number; distance: number }[] {
    const floor = WorldManager.getInstance().currentFloor;
    if (!floor) return [];
    this.ensureWalls(floor);
    const rayCount = Math.max(8, Math.round(this.perf.rayCount * light.resolutionMultiplier));
    const result: { angle: number; distance: number }[] = [];
    for (let i = 0; i < rayCount; i++) {
      const angle = (i * Math.PI * 2) / rayCount;
      const dx = Math.cos(angle);
      const dy = Math.sin(angle);
      let hit = this.perf.maxDistance;
      for (let d = this.perf.stepSize; d <= this.perf.maxDistance; d += this.perf.stepSize) {
        if (this.isBlocked(ox + dx * d, oy + dy * d)) {
          hit = d;
          break;
        }
      }
      result.push({ angle, distance: hit });
    }
    return result;
  }

  // ============ 光照纹理（离屏渲染，文档 8.2） ============

  private invalidateTextures(): void {
    this.textures.clear();
    this.lastDynPos.clear();
    this.textureFloorId = -1;
  }

  /** 动态光源上次计算位置（格坐标，用于 5px 复用判定） */
  private lastDynPos = new Map<string, { x: number; y: number }>();

  /** 获取光源纹理（带缓存：静态光源按 id 永久复用，动态光源按位移/帧间隔复用） */
  private getTexture(light: RayLight, timeMs: number): LightTexture | null {
    const floor = WorldManager.getInstance().currentFloor;
    if (!floor) return null;
    if (this.textureFloorId !== floor.floorId || this.textureScale !== this.effScale) {
      this.invalidateTextures();
      this.textureFloorId = floor.floorId;
      this.textureScale = this.effScale;
    }

    const cached = this.textures.get(light.id);
    if (cached) {
      if (light.isStatic) return cached; // L1 静态缓存：永不变化
      // L2 动态缓存：位移 ≤5px 且未超 updateInterval 帧时复用（文档 5.5）
      light.updateCounter++;
      const lp = this.lastDynPos.get(light.id);
      const movedPx = lp
        ? Math.hypot(light.x - lp.x, light.y - lp.y) * projection.tileSize
        : Infinity;
      if (movedPx <= 5 && light.updateCounter < this.perf.updateInterval) return cached;
      light.updateCounter = 0;
    }

    const radius = Math.min(light.radius, this.perf.maxDistance);
    const tex = this.computeTexture(light, radius, timeMs);
    this.textures.set(light.id, tex);
    this.lastDynPos.set(light.id, { x: light.x, y: light.y });
    return tex;
  }

  private computeTexture(light: RayLight, radius: number, timeMs: number): LightTexture {
    const scale = this.effScale;
    const size = Math.max(8, Math.ceil(radius * 2 * scale));
    const canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    const c = canvas.getContext('2d')!;
    const cx = size / 2;
    const cy = size / 2;

    const flickerFactor = light.flicker.enabled
      ? 1 - light.flicker.amplitude * (0.5 + 0.5 * Math.sin((timeMs / 1000) * light.flicker.speed * Math.PI * 2))
      : 1;
    const intensity = Math.max(0, Math.min(1, light.intensity * flickerFactor));

    // 1. 径向光晕基础（混合衰减）
    const grad = c.createRadialGradient(cx, cy, 0, cx, cy, radius * scale);
    grad.addColorStop(0, `rgba(${light.color.r},${light.color.g},${light.color.b},${(intensity * 0.95).toFixed(3)})`);
    grad.addColorStop(0.5, `rgba(${light.color.r},${light.color.g},${light.color.b},${(intensity * attenuationAt(radius * 0.5, radius)).toFixed(3)})`);
    grad.addColorStop(1, `rgba(${light.color.r},${light.color.g},${light.color.b},0)`);
    c.fillStyle = grad;
    c.fillRect(0, 0, size, size);

    // 2. 光线投射（光源像素原点）
    const ts = projection.tileSize;
    const origin = projection.tileCenter(light.y, light.x);
    // 纹理坐标 → 原点在纹理中心；射线在世界像素空间步进后转纹理空间
    const ox = origin.x;
    const oy = origin.y;
    const hits = this.rayCast(ox, oy, light);

    // 3. 阴影楔形（multiply 由主画布合成时整体生效；此处 source-over 绘制在纹理上）
    const rayCount = Math.max(8, Math.round(this.perf.rayCount * light.resolutionMultiplier));
    const spread = (Math.PI * 2 / rayCount) * 0.55; // 相邻射线角度的一半（略重叠防缝隙）
    if (this.perf.shadowSoftness > 0) c.filter = `blur(${(this.perf.shadowSoftness * 3).toFixed(1)}px)`;
    for (const { angle, distance } of hits) {
      if (distance >= this.perf.maxDistance) continue; // 未碰撞的射线不产生阴影
      const sc = calculateShadowColor(light.color, distance, radius);
      // 提亮阴影色避免纯黑不可读（阴影=深色变体，保留场景细节）
      const r = Math.min(255, sc.r + 70);
      const g = Math.min(255, sc.g + 70);
      const b = Math.min(255, sc.b + 80);
      const a = 0.55 + 0.4 * (1 - attenuationAt(distance, radius)); // 距离越深阴影越重
      c.fillStyle = `rgba(${r.toFixed(0)},${g.toFixed(0)},${b.toFixed(0)},${a.toFixed(2)})`;
      c.beginPath();
      c.moveTo(cx, cy);
      c.arc(cx, cy, distance * scale, angle - spread, angle + spread);
      c.closePath();
      c.fill();
    }
    c.filter = 'none';

    return { canvas, worldSize: radius * 2, lastUpdate: timeMs };
  }

  // ============ 绘制 ============

  /**
   * 光照纹理合成（管线第5层）：multiply 混合绘制到主画布（相机空间）。
   * 被阴影楔形覆盖处呈现阴影色（深色变体），光照处呈光源色温。
   */
  drawLightTextures(ctx: CanvasRenderingContext2D, timeMs: number, view: { left: number; right: number; top: number; bottom: number }): void {
    ctx.save();
    ctx.globalCompositeOperation = 'multiply';
    for (const light of this.lights) {
      const center = projection.tileCenter(light.y, light.x);
      if (center.x + light.radius < view.left || center.x - light.radius > view.right
        || center.y + light.radius < view.top || center.y - light.radius > view.bottom) continue;
      const tex = this.getTexture(light, timeMs);
      if (!tex) continue;
      ctx.drawImage(tex.canvas, center.x - tex.worldSize / 2, center.y - tex.worldSize / 2, tex.worldSize, tex.worldSize);
    }
    ctx.restore();
  }

  /** 地面光晕（管线第6层，lighter 提亮）：混合衰减径向渐变 */
  drawGroundLights(ctx: CanvasRenderingContext2D, timeMs: number, view: { left: number; right: number; top: number; bottom: number }): void {
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    for (const light of this.lights) {
      const center = projection.tileCenter(light.y, light.x);
      if (center.x + light.radius < view.left || center.x - light.radius > view.right
        || center.y + light.radius < view.top || center.y - light.radius > view.bottom) continue;
      const flickerFactor = light.flicker.enabled
        ? 1 - light.flicker.amplitude * (0.5 + 0.5 * Math.sin((timeMs / 1000) * light.flicker.speed * Math.PI * 2))
        : 1;
      const a = Math.max(0, Math.min(1, light.intensity * flickerFactor)) * 0.5;
      const r = light.radius * 0.8;
      const grad = ctx.createRadialGradient(center.x, center.y, 0, center.x, center.y, r);
      grad.addColorStop(0, `rgba(${light.color.r},${light.color.g},${light.color.b},${(a * attenuationAt(0, light.radius)).toFixed(3)})`);
      grad.addColorStop(0.5, `rgba(${light.color.r},${light.color.g},${light.color.b},${(a * attenuationAt(light.radius * 0.4, light.radius)).toFixed(3)})`);
      grad.addColorStop(1, `rgba(${light.color.r},${light.color.g},${light.color.b},0)`);
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(center.x, center.y, r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }

  /** 墙壁光晕（管线第9层）：光源竖向扩散光（wallGlow>0 的类型） */
  drawWallLights(ctx: CanvasRenderingContext2D, timeMs: number): void {
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    for (const light of this.lights) {
      if (light.wallGlow <= 0) continue;
      const center = projection.tileCenter(light.y, light.x);
      const flickerFactor = light.flicker.enabled
        ? 1 - light.flicker.amplitude * 0.5 * (0.5 + 0.5 * Math.sin((timeMs / 1000) * light.flicker.speed * Math.PI * 2))
        : 1;
      const h = light.wallGlow * flickerFactor;
      const grad = ctx.createLinearGradient(center.x, center.y, center.x, center.y - h);
      grad.addColorStop(0, `rgba(${light.color.r},${light.color.g},${light.color.b},${(light.intensity * 0.3).toFixed(3)})`);
      grad.addColorStop(1, `rgba(${light.color.r},${light.color.g},${light.color.b},0)`);
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.ellipse(center.x, center.y - h / 2, h * 0.45, h / 2, 0, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }

  // ============ 调试 ============

  /** 缓存命中率/帧率统计（验证 5.2/9.2） */
  stats(): { fps: number; resolutionScale: number; activeLights: number; cachedTextures: number; level: number } {
    return {
      fps: Math.round(this.fpsEma),
      resolutionScale: Number(this.effScale.toFixed(2)),
      activeLights: this.lights.length,
      cachedTextures: this.textures.size,
      level: PERF_LEVELS.indexOf(this.perf),
    };
  }
}
